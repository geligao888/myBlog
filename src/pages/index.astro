---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('journal')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<SiteLayout activePage="home">
  <section class="shell hero-section">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span> 一间正在整理的数字房间</p>
      <h1>把学到的，<br /><em>过成自己的。</em></h1>
      <p class="hero-description">你好，欢迎来坐坐。这里收集我正在学习的事，也收集那些值得记下来的日常片刻。</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${base}archive/`}>读读最近的文章 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}about/`}>认识一下作者 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-art" aria-label="一本摊开的手账和一枝植物的装饰插画" role="img">
      <div class="art-sun"></div>
      <div class="art-leaf leaf-one"></div><div class="art-leaf leaf-two"></div><div class="art-leaf leaf-three"></div>
      <div class="art-stem"></div>
      <div class="art-book"><span></span><span></span><span></span><span></span><i>today<br />is a good<br />day to begin</i></div>
      <span class="art-caption">vol. 01&nbsp; / &nbsp;still becoming</span>
      <span class="art-sparkle sparkle-one">✳</span><span class="art-sparkle sparkle-two">✳</span>
    </div>
  </section>

  <section class="shell intro-strip">
    <span class="section-index">01 / 关于这里</span>
    <p>记录不是为了把生活定格，<br class="desktop-break" />而是为了在回望时，发现自己曾经认真地走过。</p>
    <a href={`${base}about/`} aria-label="了解关于拾页">了解更多 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="shell recent-section">
    <div class="section-heading">
      <div><span class="section-index">02 / 最近写下</span><h2>新鲜出炉的几页</h2></div>
      <a class="text-link" href={`${base}archive/`}>所有文章 <span aria-hidden="true">→</span></a>
    </div>
    <div class="post-grid">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="shell note-band">
    <span class="note-star" aria-hidden="true">✳</span>
    <div><p class="eyebrow">给正在路上的你</p><h2>不用准备好，<br class="mobile-break" />也可以从今天开始。</h2></div>
    <a class="button button-quiet" href={`${base}archive/`}>去翻翻手账 <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
