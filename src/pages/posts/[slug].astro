---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.pubDate);
---

<SiteLayout title={`${post.data.title} · 拾页`} description={post.data.description}>
  <article class="shell article-page">
    <a class="back-link" href={`${base}archive/`}><span aria-hidden="true">←</span> 返回文章归档</a>
    <header class="article-header">
      <span class:list={['category-label', post.data.category === '学习' ? 'category-study' : 'category-life']}>{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-meta"><time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{date}</time><span aria-hidden="true">·</span><span>{post.data.tags.map((tag) => `#${tag}`).join('　')}</span></div>
    </header>
    <div class="article-font-controls" aria-label="正文显示设置" hidden>
      <span>正文</span>
      <button class="font-size-button" type="button" data-font-size="decrease" aria-label="缩小正文字号" title="缩小正文字号">A−</button>
      <output class="font-size-value" aria-live="polite"></output>
      <button class="font-size-button" type="button" data-font-size="increase" aria-label="放大正文字号" title="放大正文字号">A＋</button>
      <button class="font-size-reset" type="button" data-font-size="reset">重置</button>
    </div>
    <div class="article-body"><Content /></div>
    <footer class="article-end"><span aria-hidden="true">✳</span><p>谢谢你读到这里。<br />愿今天也有值得记下的一页。</p><a class="text-link" href={`${base}archive/`}>继续阅读 <span aria-hidden="true">→</span></a></footer>
  </article>
</SiteLayout>

<script>
  const controls = document.querySelector('.article-font-controls');
  const valueOutput = controls?.querySelector('.font-size-value');
  const sizeButtons = controls?.querySelectorAll('[data-font-size]');
  const preferenceKey = 'journal-article-font-size';
  const minSize = 14;
  const maxSize = 28;
  const step = 2;

  if (controls && valueOutput && sizeButtons) {
    const root = document.documentElement;
    const storedSize = Number(localStorage.getItem(preferenceKey));
    let fontSize = Number.isFinite(storedSize) && storedSize >= minSize && storedSize <= maxSize
      ? storedSize
      : Number.parseFloat(getComputedStyle(root).getPropertyValue('--font-size-article'));

    const renderSize = () => {
      root.style.setProperty('--font-size-article', `${fontSize}px`);
      valueOutput.textContent = `${fontSize}px`;
      controls.querySelector('[data-font-size="decrease"]').disabled = fontSize <= minSize;
      controls.querySelector('[data-font-size="increase"]').disabled = fontSize >= maxSize;
    };

    sizeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.dataset.fontSize === 'reset') {
          localStorage.removeItem(preferenceKey);
          root.style.removeProperty('--font-size-article');
          fontSize = Number.parseFloat(getComputedStyle(root).getPropertyValue('--font-size-article'));
        } else {
          const direction = button.dataset.fontSize === 'increase' ? 1 : -1;
          fontSize = Math.min(maxSize, Math.max(minSize, fontSize + direction * step));
          localStorage.setItem(preferenceKey, String(fontSize));
        }
        renderSize();
      });
    });

    renderSize();
    controls.hidden = false;
  }
</script>
