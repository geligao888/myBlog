---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.pubDate);
---

<SiteLayout title={`${post.data.title} · 拾页`} description={post.data.description}>
  <article class="shell article-page">
    <a class="back-link" href={`${base}archive/`}><span aria-hidden="true">←</span> 返回文章归档</a>
    <header class="article-header">
      <span class:list={['category-label', post.data.category === '学习' ? 'category-study' : 'category-life']}>{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-meta"><time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{date}</time><span aria-hidden="true">·</span><span>{post.data.tags.map((tag) => `#${tag}`).join('　')}</span></div>
    </header>
    <div class="article-body"><Content /></div>
    <footer class="article-end"><span aria-hidden="true">✳</span><p>谢谢你读到这里。<br />愿今天也有值得记下的一页。</p><a class="text-link" href={`${base}archive/`}>继续阅读 <span aria-hidden="true">→</span></a></footer>
  </article>
</SiteLayout>
