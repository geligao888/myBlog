---
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.pubDate);
---

<article class="post-card">
  <div class="post-card-top">
    <span class:list={['category-label', post.data.category === '学习' ? 'category-study' : 'category-life']}>{post.data.category}</span>
    <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{date}</time>
  </div>
  <h3><a href={`${base}posts/${post.id}/`}>{post.data.title}<span aria-hidden="true"> ↗</span></a></h3>
  <p>{post.data.description}</p>
  <div class="tag-list" aria-label="文章标签">
    {post.data.tags.map((tag) => <span>#{tag}</span>)}
  </div>
</article>
